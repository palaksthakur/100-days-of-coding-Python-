print("Welcome to the tip calculaor!")
bill = float(input("What was your total bill? $ "))
Tip = int(input("How much tip would you like to give? 10, 12 or 15. "))
n_people = int(input("How many people to split the bill? "))
tip_value = (bill*(Tip/100))
total_bill = (bill+tip_value)
split = (total_bill/n_people)
split_total = round(split,2)
print(f"Each person should pay: ${split_total}")
